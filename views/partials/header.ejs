<header>
  <a class="clubhouse-logo" href="/">
    Clubhouse
  </a>
  <% if (!locals.user) { %>
  <nav>
    <a href="/login">
      <div>Login</div>
    </a>
  </nav>
  <% } else { %>
  <nav>
    <span class="username"><%= user.username %></span>
    <a href="/add-message">
      <div>Add message</div>
    </a>
    <a href="/codes">Codes</a>
    <a href="/logout">Log Out</a>
  </nav>
  <% } %>
</header>